<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Location Action -->
    <record id="action_una_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">una.location</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create locations for inventory storage
                <br/>
                <span class="text-muted">Hierarchy: Warehouse -> Station -> Location</span>
            </p>
        </field>
    </record>

    <!-- Location Tree View -->
    <record id="view_una_location_tree" model="ir.ui.view">
        <field name="name">una.location.tree</field>
        <field name="model">una.location</field>
        <field name="arch" type="xml">
            <tree string="Locations">
                <field name="code"/>
                <field name="display_name"/>
                <field name="warehouse_id"/>
                <field name="station_id"/>
                <field name="active" widget="boolean"/>
            </tree>
        </field>
    </record>

    <!-- Location Form View -->
    <record id="view_una_location_form" model="ir.ui.view">
        <field name="name">una.location.form</field>
        <field name="model">una.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Location Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="warehouse_id"/>
                            <field name="station_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="display_name" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_una_location_search" model="ir.ui.view">
        <field name="name">una.location.search</field>
        <field name="model">una.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Location"/>
                <field name="code" string="Code"/>
                <field name="warehouse_id"/>
                <field name="station_id"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active','=',False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/>
                    <filter name="group_by_station" string="Station" context="{'group_by':'station_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>