<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asset Action -->
    <record id="action_una_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">una.asset</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Asset Tree View -->
    <record id="view_una_asset_tree" model="ir.ui.view">
        <field name="name">una.asset.tree</field>
        <field name="model">una.asset</field>
        <field name="arch" type="xml">
            <tree string="Assets">
                <field name="asset_tag"/>
                <field name="status" widget="badge"/>
                <field name="serial_number"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="source_location" readonly="1"/>
                <field name="current_location"/>
                <field name="last_move_date" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="view_una_asset_form" model="ir.ui.view">
        <field name="name">una.asset.form</field>
        <field name="model">una.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_assign_simple" string="Assign" type="object" class="btn-primary" invisible="status != 'available'"/>
                    <button name="action_make_available" string="Make Available" type="object" class="btn-secondary" invisible="status != 'assigned'"/>
                    <button name="action_scrap" string="Scrap" type="object" class="btn-danger" invisible="status == 'scrapped'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Asset Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="serial_number"/>
                            <field name="asset_tag"/>
                            <field name="status" widget="badge"/>
                            <field name="source_location" readonly="1"/>
                            <field name="current_location"/>
                            <field name="last_move_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="cost_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="purchase_date"/>
                            <field name="assigned_to"/>
                            <field name="assigned_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>