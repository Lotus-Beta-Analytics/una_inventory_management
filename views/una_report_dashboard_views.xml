<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_una_report_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">una.report.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p>Executive dashboard showing key inventory metrics and KPIs.</p>
        </field>
    </record>

    <report id="action_report_una_dashboard"
            model="una.report.dashboard"
            string="Inventory Dashboard"
            report_type="qweb-pdf"
            name="una_inventory_management.report_dashboard_template"
            file="una_inventory_management.report_dashboard_template"
            attachment_use="False"/>

    <record id="view_una_report_dashboard_form" model="ir.ui.view">
        <field name="name">una.report.dashboard.form</field>
        <field name="model">una.report.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard">
                <header>
                    <button name="action_refresh_dashboard" string="Refresh" type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Export Excel" type="object" class="btn-secondary"/>
                    <button name="action_export_pdf" string="Export PDF" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1 style="font-size: 28px; font-weight: 700; color: #1a1a2e; letter-spacing: -0.5px;">
                             Inventory Dashboard
                        </h1>
                        <p style="color: #6c757d; font-size: 14px; margin-top: 4px;">
                            Real-time overview of your inventory operations
                        </p>
                    </div>

                    <!-- KPI Cards -->
                    <div class="row" style="margin-top: 20px; margin-bottom: 10px;">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 16px; padding: 20px 24px; color: white; box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <div>
                                        <p style="font-size: 13px; opacity: 0.8; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">Total Value</p>
                                        <div style="display: flex; align-items: baseline; gap: 6px; margin-top: 4px;">
                                            <h2 style="font-size: 28px; font-weight: 700; margin: 0;">
                                                <field name="total_inventory_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </h2>
                                        </div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 8px 12px;">
                                        <i class="fa fa-money" style="font-size: 20px;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border-radius: 16px; padding: 20px 24px; color: white; box-shadow: 0 8px 32px rgba(245, 87, 108, 0.3);">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <div>
                                        <p style="font-size: 13px; opacity: 0.8; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">Total Assets</p>
                                        <h2 style="font-size: 28px; font-weight: 700; margin: 4px 0 0 0;"><field name="total_assets"/></h2>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 8px 12px;">
                                        <i class="fa fa-boxes" style="font-size: 20px;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border-radius: 16px; padding: 20px 24px; color: white; box-shadow: 0 8px 32px rgba(79, 172, 254, 0.3);">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <div>
                                        <p style="font-size: 13px; opacity: 0.8; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">Pending Requisitions</p>
                                        <h2 style="font-size: 28px; font-weight: 700; margin: 4px 0 0 0;"><field name="pending_requisitions"/></h2>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 8px 12px;">
                                        <i class="fa fa-clock" style="font-size: 20px;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); border-radius: 16px; padding: 20px 24px; color: #1a1a2e; box-shadow: 0 8px 32px rgba(250, 112, 154, 0.3);">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <div>
                                        <p style="font-size: 13px; opacity: 0.8; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">Discrepancies</p>
                                        <h2 style="font-size: 28px; font-weight: 700; margin: 4px 0 0 0;"><field name="stock_count_discrepancies"/></h2>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.2); border-radius: 12px; padding: 8px 12px;">
                                        <i class="fa fa-exclamation-triangle" style="font-size: 20px;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Row -->
                    <div class="row" style="margin-top: 20px;">
                        <div class="col-md-6">
                            <div style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 2px 16px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.04); height: 100%;">
                                <div style="display: flex; align-items: center; margin-bottom: 16px;">
                                    <div style="background: #e8f5e9; border-radius: 10px; padding: 8px 12px; margin-right: 12px;">
                                        <i class="fa fa-map-marker" style="color: #2e7d32; font-size: 16px;"/>
                                    </div>
                                    <h6 style="font-weight: 600; color: #1a1a2e; margin: 0; font-size: 15px;">Inventory by Location</h6>
                                    <span style="margin-left: auto; font-size: 11px; color: #2e7d32; background: #e8f5e9; padding: 2px 10px; border-radius: 12px;">Value</span>
                                </div>
                                <div style="background: #f8f9fa; border-radius: 12px; padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; line-height: 1.8; color: #2d3436; min-height: 120px; white-space: pre-wrap;">
                                    <field name="inventory_by_location" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 2px 16px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.04); height: 100%;">
                                <div style="display: flex; align-items: center; margin-bottom: 16px;">
                                    <div style="background: #e3f2fd; border-radius: 10px; padding: 8px 12px; margin-right: 12px;">
                                        <i class="fa fa-pie-chart" style="color: #1565c0; font-size: 16px;"/>
                                    </div>
                                    <h6 style="font-weight: 600; color: #1a1a2e; margin: 0; font-size: 15px;">Inventory by Type</h6>
                                    <span style="margin-left: auto; font-size: 11px; color: #1565c0; background: #e3f2fd; padding: 2px 10px; border-radius: 12px;">Breakdown</span>
                                </div>
                                <div style="background: #f8f9fa; border-radius: 12px; padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; line-height: 1.8; color: #2d3436; min-height: 120px; white-space: pre-wrap;">
                                    <field name="inventory_by_type" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row" style="margin-top: 20px;">
                        <div class="col-md-6">
                            <div style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 2px 16px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.04); height: 100%;">
                                <div style="display: flex; align-items: center; margin-bottom: 16px;">
                                    <div style="background: #fff3e0; border-radius: 10px; padding: 8px 12px; margin-right: 12px;">
                                        <i class="fa fa-tasks" style="color: #e65100; font-size: 16px;"/>
                                    </div>
                                    <h6 style="font-weight: 600; color: #1a1a2e; margin: 0; font-size: 15px;">Requisitions by Status</h6>
                                    <span style="margin-left: auto; font-size: 11px; color: #e65100; background: #fff3e0; padding: 2px 10px; border-radius: 12px;">Count</span>
                                </div>
                                <div style="background: #f8f9fa; border-radius: 12px; padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; line-height: 1.8; color: #2d3436; min-height: 120px; white-space: pre-wrap;">
                                    <field name="requisition_by_state" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 2px 16px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.04); height: 100%;">
                                <div style="display: flex; align-items: center; margin-bottom: 16px;">
                                    <div style="background: #fce4ec; border-radius: 10px; padding: 8px 12px; margin-right: 12px;">
                                        <i class="fa fa-exchange" style="color: #c62828; font-size: 16px;"/>
                                    </div>
                                    <h6 style="font-weight: 600; color: #1a1a2e; margin: 0; font-size: 15px;">Stock Movements by Type</h6>
                                    <span style="margin-left: auto; font-size: 11px; color: #c62828; background: #fce4ec; padding: 2px 10px; border-radius: 12px;">Count</span>
                                </div>
                                <div style="background: #f8f9fa; border-radius: 12px; padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; line-height: 1.8; color: #2d3436; min-height: 120px; white-space: pre-wrap;">
                                    <field name="stock_movements_by_type" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Movements & Low Stock -->
                    <div class="row" style="margin-top: 20px;">
                        <div class="col-md-6">
                            <div style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 2px 16px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.04); height: 100%;">
                                <div style="display: flex; align-items: center; margin-bottom: 16px;">
                                    <div style="background: #e8eaf6; border-radius: 10px; padding: 8px 12px; margin-right: 12px;">
                                        <i class="fa fa-history" style="color: #283593; font-size: 16px;"/>
                                    </div>
                                    <h6 style="font-weight: 600; color: #1a1a2e; margin: 0; font-size: 15px;">Recent Movements</h6>
                                    <span style="margin-left: auto; font-size: 11px; color: #999; background: #f5f5f5; padding: 2px 10px; border-radius: 12px;">Last 10</span>
                                </div>
                                <div style="max-height: 320px; overflow-y: auto;">
                                    <field name="recent_movements" widget="html" options="{'safe': True}"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 2px 16px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.04); height: 100%;">
                                <div style="display: flex; align-items: center; margin-bottom: 16px;">
                                    <div style="background: #ffebee; border-radius: 10px; padding: 8px 12px; margin-right: 12px;">
                                        <i class="fa fa-exclamation-circle" style="color: #b71c1c; font-size: 16px;"/>
                                    </div>
                                    <h6 style="font-weight: 600; color: #1a1a2e; margin: 0; font-size: 15px;">Low Stock Alerts</h6>
                                    <span style="margin-left: auto; font-size: 11px; color: #d32f2f; background: #ffebee; padding: 2px 10px; border-radius: 12px; font-weight: 500;">⚠️ Action Required</span>
                                </div>
                                <div style="max-height: 320px; overflow-y: auto;">
                                    <field name="low_stock_alerts" widget="html" options="{'safe': True}"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div style="margin-top: 24px; padding: 16px 0; text-align: center; border-top: 1px solid #f0f0f0;">
                        <p style="font-size: 12px; color: #adb5bd; margin: 0;">
                            <i class="fa fa-refresh" style="margin-right: 4px;"/>
                            Data updates automatically on refresh
                            <span style="margin: 0 8px;">•</span>
                            <i class="fa fa-shield" style="margin-right: 4px;"/>
                            UNA Inventory Management v17.0
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>